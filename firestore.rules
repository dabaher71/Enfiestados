rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isVerified() {
      return isAuth() && request.auth.token.email_verified == true;
    }
    function isBlocked(data) {
      return request.auth.uid in data.get('usuariosBloqueados', []);
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && (
        isOwner(userId) ||
        (resource.data.perfilPublico == true && !isBlocked(resource.data)) ||
        (request.auth.uid in resource.data.get('followers', []) && !isBlocked(resource.data))
      );
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── events ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isVerified() &&
        request.resource.data.organizerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'category', 'organizerId', 'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100;
      allow update: if isAuth() && (
        // El organizador puede editar todo
        resource.data.organizerId == request.auth.uid ||
        // Otros solo pueden tocar likes, attendees y comments
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'attendees', 'comments'])
      );
      allow delete: if isAuth() && resource.data.organizerId == request.auth.uid;
    }

    // ── posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'createdAt']) &&
        (
          !('text' in request.resource.data) ||
          (request.resource.data.text is string && request.resource.data.text.size() <= 1000)
        );
      allow update: if isAuth() && (
        // El autor puede editar su propio post
        resource.data.userId == request.auth.uid ||
        // Otros solo pueden tocar likes y comments
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'comments'])
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── chats ─────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, update: if isAuth() &&
        request.auth.uid in resource.data.participants;
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.keys().hasAll(['participants', 'createdAt']);
    }

    // ── messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuth() && (
        exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants
      );
      allow create: if isAuth() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.keys().hasAll(['chatId', 'senderId', 'text', 'timestamp']) &&
        exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants;
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── eventos_externos ──────────────────────────────────────────────────────
    match /eventos_externos/{eventId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isVerified() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        request.resource.data.targetType in ['user', 'event', 'post'] &&
        request.resource.data.status == 'pending';
      // Cada usuario puede leer solo sus propios reportes (necesario para verificar duplicados)
      allow read: if isAuth() && resource.data.reporterId == request.auth.uid;
      allow update, delete: if false; // solo admin via Cloud Functions
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.toUserId == request.auth.uid;
      allow create: if isAuth() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId != request.resource.data.toUserId;
      allow update: if isAuth() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuth() && resource.data.toUserId == request.auth.uid;
    }

  }
}
