rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isVerified() {
      return isAuth() && request.auth.token.email_verified == true;
    }
    function isBlocked(data) {
      return request.auth.uid in data.get('usuariosBloqueados', []);
    }
    // Bloqueo mutuo entre el usuario actual y otherUid: cualquiera de los dos
    // pudo haber bloqueado al otro. Usado para negar chats/mensajes entre
    // ambos aunque el cliente esté modificado — la UI ya oculta estas
    // acciones, esto es la barrera real del lado del servidor.
    function isBlockedPair(otherUid) {
      return isBlocked(get(/databases/$(database)/documents/users/$(otherUid)).data) ||
        otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('usuariosBloqueados', []);
    }
    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }
    function isAdminUser() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    // Comentarios en array: las reglas no pueden mirar QUÉ elemento cambió,
    // solo cuántos hay, así que no se puede validar la autoría de uno suelto.
    // Lo que sí se puede:
    //   - al agregar, exigir que los viejos queden intactos como prefijo —
    //     si no, se podía reescribir el hilo entero con tal de que el conteo
    //     subiera en uno;
    //   - al borrar, limitar a uno por escritura, que frena el vaciado masivo.
    // Queda abierto: borrar el comentario de otro de a uno, y reescribir el
    // hilo al borrar. Cerrarlo de verdad exige moverlos a subcolección, donde
    // cada comentario es un documento con su propio dueño.
    function isCommentAppendOrSingleDelete(oldList, newList) {
      return (
        newList.size() == oldList.size() + 1 &&
        newList[0:oldList.size()] == oldList
      ) || newList.size() == oldList.size() - 1;
    }
    // Solo permite agregar o quitar EXACTAMENTE el propio uid de un array —
    // evita que cualquiera vacíe o manipule likes/attendees/savedBy ajenos.
    function isUidToggle(oldList, newList, uid) {
      let added = newList.toSet().difference(oldList.toSet());
      let removed = oldList.toSet().difference(newList.toSet());
      return added.size() + removed.size() == 1 &&
        added.hasOnly([uid]) && removed.hasOnly([uid]);
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles (necesario para mostrar
    // avatares en comentarios, chats y eventos). La lógica de privacidad
    // (cuenta privada) se controla a nivel de app en UserProfileScreen.
    match /users/{userId} {
      allow read: if isAuth();
      // isAdmin nunca se toca desde el cliente: es el campo que autorizan
      // processReportAction/triggerScrape (functions/index.js). Solo se
      // otorga manualmente por el equipo (Firebase Console / Admin SDK).
      allow create: if isOwner(userId) && !('isAdmin' in request.resource.data);
      allow update: if (
        // (a) El dueño edita su perfil. Antes esta rama solo bloqueaba
        // 'isAdmin', así que cualquiera podía auto-asignarse `verificado`
        // (insignia de confianza), `isAdvertiser` o `adCredits` — que
        // AdCenterScreen lee como saldo real.
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin', 'isAdvertiser', 'adCredits', 'verificado',
          'banned', 'bannedAt', 'bannedReason'
        ]) &&
        // Sobre sus propios followers solo puede QUITAR (sacarse un seguidor
        // o la limpieza al bloquear). Agregar sería inflarse el contador.
        request.resource.data.get('followers', []).toSet()
          .difference(resource.data.get('followers', []).toSet()).size() == 0
      ) || (
        // (b) Otra persona siguiéndote o dejando de seguirte: solo puede
        // mover SU PROPIO uid. Esta rama faltaba — la regla anterior exigía
        // isOwner, así que seguir siempre fallaba con permission-denied y el
        // catch {} de UserProfileScreen se lo tragaba en silencio.
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']) &&
        isUidToggle(resource.data.get('followers', []), request.resource.data.followers, request.auth.uid)
      ) || (
        // (c) Solicitud de seguimiento a una cuenta privada, misma lógica.
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followRequests']) &&
        isUidToggle(resource.data.get('followRequests', []), request.resource.data.followRequests, request.auth.uid)
      ) || (
        // (d) Admin: solo adCredits (addCredits() en adService.js).
        isAdminUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adCredits'])
      );
      allow delete: if isOwner(userId);
    }

    // ── events ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isAuth();
      allow create: if isVerified() &&
        request.resource.data.organizerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'category', 'organizerId', 'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100;
      allow update: if isAuth() && (
        // El organizador puede editar todo
        resource.data.organizerId == request.auth.uid ||
        // Otros solo pueden tocar UN campo social por escritura, y solo
        // agregar/quitar su propio uid (o su propio comentario)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          isUidToggle(resource.data.get('likes', []), request.resource.data.likes, request.auth.uid)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']) &&
          isUidToggle(resource.data.get('attendees', []), request.resource.data.attendees, request.auth.uid)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedBy']) &&
          isUidToggle(resource.data.get('savedBy', []), request.resource.data.savedBy, request.auth.uid)
        ) ||
        (
          // Comentarios: no se puede validar el autor de un elemento individual
          // en rules, pero al menos se bloquea el vaciado masivo — solo se
          // permite crecer o achicarse de a un comentario por escritura.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']) &&
          isCommentAppendOrSingleDelete(
            resource.data.get('comments', []), request.resource.data.comments)
        )
      );
      allow delete: if isAuth() && resource.data.organizerId == request.auth.uid;
    }

    // ── posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create: if isVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'createdAt']) &&
        (
          !('text' in request.resource.data) ||
          (request.resource.data.text is string && request.resource.data.text.size() <= 1000)
        ) &&
        // Hasta 3 medios por publicación. El lenguaje de reglas no sabe
        // iterar listas, así que acá solo se puede acotar la cantidad; la
        // forma de cada elemento ({type, url}) la arma el cliente y el
        // tamaño y tipo real del archivo los corta storage.rules al subirlo.
        (
          !('media' in request.resource.data) || (
            request.resource.data.media is list &&
            request.resource.data.media.size() <= 3
          )
        ) &&
        // `image` es el primer medio, desnormalizado. Se valida que apunte a
        // Storage de este proyecto para que el campo no sirva como vía de
        // incrustar contenido alojado afuera.
        (
          !('image' in request.resource.data) ||
          request.resource.data.image == null || (
            request.resource.data.image is string &&
            request.resource.data.image.matches(
              'https://firebasestorage.googleapis.com/v0/b/enfiestados-alpha[.]firebasestorage[.]app/o/posts%2F.*'
            )
          )
        );
      allow update: if isAuth() && (
        // El autor puede editar su propio post
        resource.data.userId == request.auth.uid ||
        // Mismo endurecimiento que events. Antes bastaba con
        // hasOnly(['likes','comments']) SIN mirar los valores, así que
        // cualquiera —incluido un invitado anónimo— podía vaciar o
        // reemplazar todos los comentarios y likes de cualquier publicación.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          isUidToggle(resource.data.get('likes', []), request.resource.data.likes, request.auth.uid)
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']) &&
          isCommentAppendOrSingleDelete(
            resource.data.get('comments', []), request.resource.data.comments)
        )
      );
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── chats ─────────────────────────────────────────────────────────────────
    // Dos formas: 'direct' (1 a 1) y 'group'. Los chats creados antes de que
    // existieran los grupos no tienen `type`, así que todo lo que no diga
    // 'group' se trata como directo.
    function isGroupData(data) {
      return data.get('type', 'direct') == 'group';
    }
    match /chats/{chatId} {
      allow read: if isAuth() &&
        request.auth.uid in resource.data.participants;

      allow update: if isAuth() && (
        // (a) Cualquier participante: preview del último mensaje y su estado
        // de leído. No puede tocar participants ni la config del grupo.
        (
          request.auth.uid in resource.data.participants &&
          request.resource.data.participants == resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageTime', 'unreadFor'])
        ) || (
          // (b) Dueño del grupo: renombrar, cambiar quién puede escribir y
          // administrar miembros. No puede cambiar de dueño ni de tipo.
          isGroupData(resource.data) &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'writePolicy', 'participants', 'unreadFor']) &&
          request.resource.data.participants.size() >= 2 &&
          request.resource.data.participants.size() <= 100 &&
          // El dueño no puede sacarse a sí mismo: para irse tiene que
          // transferir el grupo (todavía no implementado) o borrarlo.
          request.resource.data.ownerId in request.resource.data.participants
        ) || (
          // (c) Salir del grupo: un miembro se quita a sí mismo y a nadie más.
          isGroupData(resource.data) &&
          request.auth.uid in resource.data.participants &&
          !(request.auth.uid in request.resource.data.participants) &&
          resource.data.ownerId != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants', 'unreadFor']) &&
          resource.data.participants.toSet().difference(
            request.resource.data.participants.toSet()
          ).hasOnly([request.auth.uid]) &&
          // Y no puede AGREGAR a nadie de paso. difference(viejo, nuevo) solo
          // mira quién salió: sin esta línea un miembro podía irse sumando
          // participantes sin límite, además sin el tope de 100 que sí tiene
          // la rama del dueño.
          request.resource.data.participants.toSet().difference(
            resource.data.participants.toSet()
          ).size() == 0
        )
      );

      allow create: if isAuth() && (
        isGroupData(request.resource.data)
          ? (
            // Grupo: el que lo crea es el dueño y queda adentro. El bloqueo
            // mutuo no se valida acá — con N participantes habría que
            // comparar todos los pares, lo que no escala en reglas. Se filtra
            // en el cliente: no ves los mensajes de quien bloqueaste.
            request.resource.data.ownerId == request.auth.uid &&
            request.auth.uid in request.resource.data.participants &&
            request.resource.data.participants.size() >= 2 &&
            request.resource.data.participants.size() <= 100 &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 60 &&
            request.resource.data.writePolicy in ['all', 'owner'] &&
            request.resource.data.keys().hasAll(['type', 'name', 'ownerId', 'writePolicy', 'participants', 'createdAt'])
          )
          : (
            request.auth.uid in request.resource.data.participants &&
            request.resource.data.participants.size() == 2 &&
            request.resource.data.keys().hasAll(['participants', 'createdAt']) &&
            !isBlockedPair(otherParticipant(request.resource.data.participants))
          )
      );
    }

    // ── messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isAuth() && (
        exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants
      );
      allow create: if isAuth() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 1000 &&
        // Antes se exigía text.size() > 0. Ahora un mensaje vale si trae texto
        // o imagen: una foto sin pie es un caso legítimo. Lo que no se permite
        // es un mensaje completamente vacío.
        (request.resource.data.text.size() > 0 || 'imageUrl' in request.resource.data) &&
        // La imagen tiene que ser una URL de Firebase Storage de ESTE proyecto.
        // Sin esto, el campo aceptaría cualquier URL y el chat se volvería un
        // vector para incrustar contenido alojado afuera.
        (
          !('imageUrl' in request.resource.data) || (
            request.resource.data.imageUrl is string &&
            request.resource.data.imageUrl.matches(
              'https://firebasestorage.googleapis.com/v0/b/enfiestados-alpha[.]firebasestorage[.]app/o/chats%2F.*'
            )
          )
        ) &&
        // En un grupo, mandar fotos es solo del dueño (el admin), aunque el
        // writePolicy sea 'all' y todos puedan escribir texto. En un directo
        // no aplica: cualquiera de los dos puede.
        (
          !('imageUrl' in request.resource.data) ||
          !isGroupData(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data) ||
          get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.ownerId == request.auth.uid
        ) &&
        request.resource.data.keys().hasAll(['chatId', 'senderId', 'text', 'timestamp']) &&
        exists(/databases/$(database)/documents/chats/$(request.resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants &&
        (
          isGroupData(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data)
            ? (
              // writePolicy 'owner' convierte al grupo en canal de avisos: la
              // UI esconde el campo de texto, pero el corte real es este — si
              // no, bastaría un cliente modificado para escribir igual.
              get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.get('writePolicy', 'all') == 'all' ||
              get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.ownerId == request.auth.uid
            )
            : !isBlockedPair(otherParticipant(get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants))
        );
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        // Faltaba la comprobación de participación que sí tiene `read`:
        // cualquiera podía marcar como leído un mensaje de un chat ajeno si
        // conocía el ID del documento.
        exists(/databases/$(database)/documents/chats/$(resource.data.chatId)) &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.participants;
      allow delete: if false;
    }

    // ── eventos_externos ──────────────────────────────────────────────────────
    match /eventos_externos/{eventId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isVerified() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt']) &&
        request.resource.data.targetType in ['user', 'event', 'post'] &&
        request.resource.data.status == 'pending';
      // El reportante lee los suyos (para evitar duplicados) y el admin lee
      // todos. Sin la rama de admin, la consulta de AdminScreen:55
      // —where('status','==','pending')— era rechazada entera y el panel de
      // moderación no mostraba ningún reporte.
      allow read: if isAuth() && (
        resource.data.reporterId == request.auth.uid || isAdminUser()
      );
      allow update, delete: if false; // solo admin via Cloud Functions
    }

    // ── userSignals ───────────────────────────────────────────────────────────
    // Cada usuario solo puede leer y escribir sus propias señales de comportamiento.
    // Nadie más (ni otros usuarios) puede acceder a este historial.
    match /userSignals/{userId} {
      allow read, write: if isOwner(userId);

      match /interactions/{eventId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'viewCount', 'longViewCount', 'opened', 'liked',
            'attended', 'commented', 'hidden', 'category', 'lastSeen'
          ]);
        allow delete: if false;
      }
    }

    // ── ads ───────────────────────────────────────────────────────────────────
    match /ads/{adId} {
      // Cualquier usuario autenticado puede leer ads activos
      allow read: if isAuth();
      // Solo anunciantes pueden crear (verificado a nivel app; admin aprueba)
      allow create: if isVerified() &&
        request.resource.data.advertiserId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('targetUrl' in request.resource.data) || request.resource.data.targetUrl.matches('^https://.*'));
      // Admin: acceso total (aprobar, rechazar, etc.)
      allow update: if isAdminUser() || (
        // El dueño SOLO puede pausar/reactivar un anuncio YA aprobado —
        // no puede pasar de 'pending' a 'active' por su cuenta (antes sí podía,
        // porque la regla vieja solo miraba qué campos cambiaban, no los valores).
        resource.data.advertiserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        resource.data.status in ['active', 'paused'] &&
        request.resource.data.status in ['active', 'paused']
      ) || (
        // Métricas: solo +1 por escritura y de a una. Antes se podía fijar
        // cualquier valor en cualquier anuncio (el TODO lo reconocía). Sigue
        // siendo client-side: para cobrar por impresiones esto tiene que
        // pasar a una Cloud Function con el uid del visor.
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions']) &&
        request.resource.data.impressions == resource.data.get('impressions', 0) + 1
      ) || (
        isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) &&
        request.resource.data.clicks == resource.data.get('clicks', 0) + 1
      );
      allow delete: if isAdminUser();
    }

    // ── advertiserRequests ────────────────────────────────────────────────────
    match /advertiserRequests/{reqId} {
      allow create: if isVerified() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdminUser());
      // approveAdvertiserRequest/rejectAdvertiserRequest (adService.js) solo tocan 'status'.
      allow update: if isAdminUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdminUser();
    }

    // ── accountDeletionRequests ──────────────────────────────────────────────
    // Solo lo tocan requestAccountDeletion/confirmAccountDeletion (Admin SDK,
    // ignora estas reglas). El cliente nunca debe leer ni escribir acá —
    // expondría el hash del código a fuerza bruta offline.
    match /accountDeletionRequests/{userId} {
      allow read, write: if false;
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.toUserId == request.auth.uid;
      // NotificationsScreen renderiza `message` y `fromUserName` tal cual, así
      // que antes cualquiera podía mandarle a cualquiera un texto arbitrario
      // con remitente inventado ("Enfiestados: tu cuenta será suspendida…").
      // Se acota el tipo y el largo, y se exige tener perfil — lo que además
      // deja fuera a los invitados anónimos, que no deberían notificar a nadie.
      // Pendiente: validar que fromUserName sea el nombre real. Hoy no se
      // puede porque EditProfileScreen cambia users/{uid}.name sin actualizar
      // el displayName de Auth, que es lo que mandan los llamadores.
      allow create: if isAuth() &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserId != request.resource.data.toUserId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        request.resource.data.type in [
          'like', 'comment', 'follow', 'follow_request', 'follow_accepted',
          'attend', 'post_like', 'post_comment', 'new_event', 'new_post'
        ] &&
        (
          !('message' in request.resource.data) ||
          (request.resource.data.message is string &&
           request.resource.data.message.size() <= 200)
        );
      allow update: if isAuth() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuth() && resource.data.toUserId == request.auth.uid;
    }

  }
}
