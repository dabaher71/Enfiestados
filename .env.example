# Copiá este archivo a .env y poné tus keys reales. .env está en .gitignore — nunca se commitea.
# Cada key se restringe en Google Cloud Console a UN SOLO package/bundle ID + su SHA-1/cert.
GOOGLE_MAPS_API_KEY_ANDROID=
# Todavía no hay build de producción de iOS — dejá esto vacío hasta crear esa key.
GOOGLE_MAPS_API_KEY_IOS=
